{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/jithujsam-cloud/reelkit/schema/design-profile.schema.json",
  "title": "reelkit design profile",
  "description": "Structured description of a website's observed design system. Every token carries a confidence and cites evidence; unknown values are null with a reason, never guessed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generator", "site", "summary", "tokens", "assets", "evidence", "conflicts", "missing", "guards", "limitations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "command"],
      "properties": { "name": { "type": "string" }, "version": { "type": "string" }, "command": { "type": "string" }, "generatedAt": { "type": "string", "description": "Optional. Absent from canonical profiles, which are byte-stable across runs; run time lives in design-profile.run.json." } }
    },
    "site": {
      "type": "object",
      "required": ["url", "pages"],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "pages": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["url"], "properties": { "url": { "type": "string" }, "title": { "type": ["string", "null"] }, "elements": { "type": "integer" }, "of": { "type": "integer" } } } },
        "title": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "lang": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "viewports": { "type": "array", "items": { "type": "object", "required": ["name", "width", "height"], "properties": { "name": { "type": "string" }, "width": { "type": "integer" }, "height": { "type": "integer" } } } },
        "designSystems": { "type": "array", "items": { "type": "object", "required": ["name", "evidence"], "properties": { "name": { "type": "string" }, "evidence": { "type": "string", "pattern": "^e[0-9]+$" } } } },
        "skipped": { "type": "array", "items": { "type": "object", "required": ["url", "kind", "reason"], "properties": { "url": { "type": "string" }, "kind": { "enum": ["auth-required", "http-error"] }, "reason": { "type": "string" } } } }
      }
    },
    "summary": {
      "type": "object",
      "required": ["overallConfidence", "level", "conflicts", "missing"],
      "properties": {
        "overallConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "level": { "$ref": "#/definitions/level" },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "coreTokens": { "type": "array", "items": { "type": "string" } },
        "conflicts": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 },
        "repoFilesRead": { "type": "integer", "minimum": 0 }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["colors", "typography", "spacing", "shape", "surfaces", "layout", "responsive", "schemes"],
      "properties": {
        "colors": { "$ref": "#/definitions/tokenGroup" },
        "typography": { "$ref": "#/definitions/tokenGroup" },
        "spacing": { "$ref": "#/definitions/tokenGroup" },
        "shape": { "$ref": "#/definitions/tokenGroup" },
        "surfaces": { "$ref": "#/definitions/tokenGroup" },
        "layout": { "$ref": "#/definitions/tokenGroup" },
        "responsive": { "$ref": "#/definitions/tokenGroup" },
        "schemes": { "$ref": "#/definitions/tokenGroup" }
      }
    },
    "assets": { "$ref": "#/definitions/tokenGroup" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "where", "detail"],
        "properties": {
          "id": { "type": "string", "pattern": "^e[0-9]+$" },
          "kind": { "enum": ["rendered", "css-variable", "repo-file", "markup"] },
          "where": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "summary", "observed", "claimed", "resolution"],
        "properties": {
          "path": { "type": "string" },
          "summary": { "type": "string" },
          "severity": { "enum": ["conflict", "info"] },
          "observed": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/claimRef" }] },
          "claimed": { "$ref": "#/definitions/claimRef" },
          "deltaE": { "type": ["number", "null"] },
          "resolution": { "enum": ["observed-kept", "declared-used"] }
        }
      }
    },
    "missing": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["path", "reason"], "properties": { "path": { "type": "string" }, "reason": { "type": "string", "minLength": 1 } } }
    },
    "guards": {
      "type": "object",
      "required": ["reelkitDefaults", "fallbacksUsed"],
      "properties": {
        "reelkitDefaults": {
          "type": "object",
          "required": ["checked", "matches"],
          "properties": {
            "checked": { "type": "array", "items": { "type": "string" } },
            "matches": { "type": "array", "items": { "type": "object", "required": ["path", "hex", "reelkitDefault", "observedOnSite", "note"] } }
          }
        },
        "fallbacksUsed": { "const": false },
        "note": { "type": "string" }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "definitions": {
    "level": { "enum": ["high", "medium", "low", "none"] },
    "claimRef": {
      "type": "object",
      "required": ["value", "evidence"],
      "properties": { "value": {}, "evidence": { "type": "string" }, "via": { "type": "string" } }
    },
    "tokenGroup": { "type": "object", "additionalProperties": { "$ref": "#/definitions/token" } },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "level", "sources"],
      "properties": {
        "value": {},
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "level": { "$ref": "#/definitions/level" },
        "sources": { "type": "array", "items": { "type": "string", "pattern": "^e[0-9]+$" } },
        "basis": { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "value": { "type": "null" } } },
      "then": { "required": ["reason"], "properties": { "confidence": { "const": 0 }, "level": { "const": "none" } } }
    }
  }
}
